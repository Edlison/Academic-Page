---
import Base from "../../layouts/base.astro";
---

<Base title="CV">
  <div class="max-w-screen-lg mx-auto px-4 sm:px-6 py-8">
    <div class="flex items-baseline justify-between gap-4 flex-wrap mb-4">
      <h1 class="text-2xl font-bold">CV</h1>
      <a
        class="link-invert text-sm"
        href="https://edlison.github.io/CV/cv.pdf"
        target="_blank"
        rel="noopener noreferrer"
      >
        Open PDF
      </a>
    </div>

    <div class="w-full border border-zinc-200 rounded-lg overflow-hidden bg-white">
      <iframe
        class="w-full"
        style="height: calc(100vh - 14rem);"
        src="https://edlison.github.io/CV/cv.pdf"
        title="CV PDF"
      ></iframe>
    </div>
  </div>
</Base>


