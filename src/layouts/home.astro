---
import Base from "./base.astro";
import Section from "../components/section.astro";
---

<Base>
  <div class="max-w-screen-lg mx-auto px-4 sm:px-6 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Left Section: Avatar and Contact Info -->
      <div class="flex flex-col items-center md:items-start space-y-4">
        <div class="w-32 h-40 overflow-hidden rounded-lg shadow-black relative">
          <img src="/people.jpg" alt="Avatar" class="w-full h-full object-cover" />
        </div>
        <div>
          <slot name="contact" />
        </div>
      </div>
      
      <!-- Middle Section: Bio -->
      <div class="col-span-2">
        <h2 class="text-2xl font-bold mb-4">Bio</h2>
        <div>
          <slot name="bio" />
        </div>
      </div>
    </div>

    <Section title="News" class="mt-12">
      <slot name="news" />
    </Section>

    <Section title="Publications" class="mt-12">
      <slot name="pubs" />
    </Section>

    <Section title="Misc" class="mt-12">
      <slot name="misc" />
    </Section>
  </div>
</Base>
