---
interface Props {
  title: string;
  msg: string;
}

const { title = "Important", msg = "This is important message!" } = Astro.props;

---

<div class="w-full p-6 border border-gray-300 bg-white rounded-lg flex items-center space-x-4 shadow hover:shadow-[4px_4px_0px_black]">
    <div class="text-red-500 w-10 h-10">
    Info
    </div>
    <div>
        <h2 class="text-xl font-bold">{title}</h2>
        <p class="text-gray-600">{msg}</p>
    </div>
</div>
