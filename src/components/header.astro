---
import { SITE_LOGO, SITE_TITLE } from "../config";
import Menus from "./menus.astro";
---

<header class="sticky z-50 top-0 bg-white/80 backdrop-blur-xl transition-all select-none">
  <div class="flex flex-row gap-8 items-center justify-between max-w-screen-lg mx-auto h-24 px-4 sm:px-6">
    <div class="flex flex-row gap-4">
      <a href="/" class="flex flex-row items-center justify-center gap-2">
        <span class="text-xl font-black no-invert">{SITE_TITLE}</span>
      </a>
    </div>
    <Menus />
  </div>
</header>
